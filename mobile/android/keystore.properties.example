# Release signing for MotionControl 手机端.
#
# Copy to keystore.properties (which .gitignore already excludes) and fill in.
# Release builds refuse to run without it -- an unsigned APK is easy to ship by
# accident, and that is how the 2.0 candidate ended up carrying the Android
# debug key.
#
# Generate the key once:
#
#   keytool -genkeypair -v \
#     -keystore motioncontrol-release.jks \
#     -alias motioncontrol \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000 \
#     -dname "CN=MotionControl, O=MotionControl, C=CN"
#
# -validity 10000 is about 27 years.  Google Play requires a key valid past
# 2033-10-22; sideloading has no such rule, but a key that expires still ends
# the app's update path, so give it room.
#
# READ THIS BEFORE YOU GENERATE IT:
#
# Sideloaded distribution has no separate upload key.  This private key IS the
# long-term app signing key, and Android requires an update's signature to
# match the installed app's.  Lose it and you can never update any installed
# copy again -- the only way out is a new applicationId, which is a new app to
# every existing user.  Leak it and someone else can publish updates that
# Android accepts as yours.
#
# So, before the first public release:
#   * keep at least two encrypted offline backups, on separate media;
#   * store the passwords somewhere that survives losing this machine;
#   * never commit the .jks or this file (both are in .gitignore -- keep them
#     there);
#   * never paste either into a log, an issue, or a crash report.
#
# storeFile is resolved against mobile/android/, so a bare filename means the
# key sits next to this file.  Keeping it outside the repo entirely is better:
# an absolute path works too.

storeFile=motioncontrol-release.jks
storePassword=CHANGE_ME
keyAlias=motioncontrol
keyPassword=CHANGE_ME
