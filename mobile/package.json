{
  "name": "motionbridge-mobile",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android && node scripts/fix-capacitor-java.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/core": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "7.6.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
